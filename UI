import pygame
import sys
import math
import random

pygame.init()

width, height = 1200, 800
screen = pygame.display.set_mode((width, height))
pygame.display.set_caption("Space Sentinel")
clock = pygame.time.Clock()
FPS = 60

font_small = pygame.font.SysFont("consolas", 16)
font_big = pygame.font.SysFont("consolas", 24, bold=True)

BG_COLOR = (4, 4, 14)
EARTH_COLOR = (60, 120, 255)
MOON_COLOUR = (255,255,255)
ORBIT_COLOR = (50, 50, 80)
TEXT_COLOR = (220, 220, 230)
WARNING_COLOR = (255, 60, 60)
DEBRIS_COLOR = (150, 150, 150)
SAT_COLORS = [(0, 255, 150), (255, 200, 0), (255, 100, 255), (0, 200, 255)]

EARTH_POS = (350, height // 2)
EARTH_RADIUS = 40

MOON_POS = (width - 200, height // 2)
MOON_RADIUS = 30

WARNING_DISTANCE = 35

def distance_to(p1, p2):
    return math.hypot(p1[0] - p2[0], p1[1] - p2[1])

def draw_text(surface, text, pos, color=TEXT_COLOR, font=font_small):
    surface.blit(font.render(text, True, color), pos)

class OrbitingObject:
    def __init__(self, orbit_radius, speed, color, label, angle=0.0, is_debris=False):
        self.base_radius = orbit_radius
        self.orbit_radius = orbit_radius
        self.speed = speed
        self.angle = angle
        self.color = color
        self.label = label
        self.is_debris = is_debris
        self.avoiding = False
        self.avoid_timer = 0

    def update(self):
        self.angle = (self.angle + self.speed) % (2 * math.pi)

        if self.avoiding:
            self.avoid_timer -= 1
            if self.avoid_timer <= 0:
                self.avoiding = False
        target = self.base_radius + (25 if self.avoiding else 0)
        self.orbit_radius += (target - self.orbit_radius) * 0.08

    def position(self):
        x = EARTH_POS[0] + self.orbit_radius * math.cos(self.angle)
        y = EARTH_POS[1] + self.orbit_radius * math.sin(self.angle)
        return (int(x), int(y))

    def start_avoidance(self):
        self.avoiding = True
        self.avoid_timer = 90

    def draw(self, surface, warning=False):
        pygame.draw.circle(surface, ORBIT_COLOR, EARTH_POS, int(self.base_radius), 1)
        color = WARNING_COLOR if warning else self.color
        radius = 4 if self.is_debris else 6
        pygame.draw.circle(surface, color, self.position(), radius)
        if not self.is_debris:
            lx, ly = self.position()
            draw_text(surface, self.label, (lx + 8, ly - 8), color)

class Rocket:
    def __init__(self, target_radius, angle):
        self.angle = angle
        self.target_radius = target_radius
        self.progress = 0.0
        self.speed = 0.01
        self.done = False

    def update(self):
        self.progress += self.speed
        if self.progress >= 1.0:
            self.progress = 1.0
            self.done = True

    def position(self):
        r = EARTH_RADIUS + (self.target_radius - EARTH_RADIUS) * self.progress
        x = EARTH_POS[0] + r * math.cos(self.angle)
        y = EARTH_POS[1] + r * math.sin(self.angle)
        return (int(x), int(y))

    def draw(self, surface):
        pygame.draw.line(surface, (255, 255, 255), EARTH_POS, self.position(), 1)
        pygame.draw.circle(surface, (255, 255, 255), self.position(), 4)

class Mission:
    def __init__(self):
        self.progress = 0.0
        self.speed = 0.004
        self.done = False
        self.control = (
            (EARTH_POS[0] + MOON_POS[0]) / 2,
            EARTH_POS[1] - 220,
        )

    def update(self):
        self.progress += self.speed
        if self.progress >= 1.0:
            self.progress = 1.0
            self.done = True

    def position(self):
        t = self.progress
        x = ((1 - t) ** 2) * EARTH_POS[0] + 2 * (1 - t) * t * self.control[0] + (t ** 2) * MOON_POS[0]
        y = ((1 - t) ** 2) * EARTH_POS[1] + 2 * (1 - t) * t * self.control[1] + (t ** 2) * MOON_POS[1]
        return (int(x), int(y))

    def draw(self, surface):
        for i in range(0, 21):
            t = i / 20
            x = ((1 - t) ** 2) * EARTH_POS[0] + 2 * (1 - t) * t * self.control[0] + (t ** 2) * MOON_POS[0]
            y = ((1 - t) ** 2) * EARTH_POS[1] + 2 * (1 - t) * t * self.control[1] + (t ** 2) * MOON_POS[1]
            pygame.draw.circle(surface, (80, 80, 60), (int(x), int(y)), 1)
        pygame.draw.circle(surface, (255, 230, 120), self.position(), 5)

def check_collisions(objects):
    warning_ids = set()
    for i in range(len(objects)):
        for j in range(i + 1, len(objects)):
            p1 = objects[i].position()
            p2 = objects[j].position()
            if distance_to(p1, p2) < WARNING_DISTANCE:
                warning_ids.add(i)
                warning_ids.add(j)
                if not objects[i].is_debris:
                    objects[i].start_avoidance()
                elif not objects[j].is_debris:
                    objects[j].start_avoidance()
    return warning_ids

satellites = [
    OrbitingObject(110, 0.022, SAT_COLORS[0], "SAT-1", angle=0.0),
    OrbitingObject(160, 0.017, SAT_COLORS[1], "SAT-2", angle=2.0),
    OrbitingObject(210, 0.013, SAT_COLORS[2], "SAT-3", angle=4.0),
]

debris = [
    OrbitingObject(160, -0.02, DEBRIS_COLOR, "DEB", angle=random.uniform(0, 6.28), is_debris=True)
    for _ in range(4)
]

all_objects = satellites + debris

rockets = []
missions = []

running = True
while running:

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        elif event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                running = False
            elif event.key == pygame.K_l:
                rockets.append(Rocket(target_radius=random.choice([110, 160, 210]),
                                       angle=random.uniform(0, 2 * math.pi)))
            elif event.key == pygame.K_m:
                missions.append(Mission())

    for obj in all_objects:
        obj.update()

    warning_ids = check_collisions(all_objects)

    for rocket in rockets:
        rocket.update()
    finished_rockets = [r for r in rockets if r.done]
    for r in finished_rockets:
        new_sat = OrbitingObject(r.target_radius, 0.018, random.choice(SAT_COLORS),
                                  f"SAT-{len(satellites) + 1}", angle=r.angle)
        satellites.append(new_sat)
        all_objects.append(new_sat)
    rockets = [r for r in rockets if not r.done]

    for mission in missions:
        mission.update()
    missions = [m for m in missions if not m.done]

    screen.fill(BG_COLOR)

    random.seed(42)
    for _ in range(80):
        sx, sy = random.randint(0, width), random.randint(0, height)
        screen.set_at((sx, sy), (90, 90, 110))
    random.seed()

    pygame.draw.circle(screen, EARTH_COLOR, EARTH_POS, EARTH_RADIUS)
    draw_text(screen, "EARTH", (EARTH_POS[0], EARTH_POS[1] + EARTH_RADIUS +  6))

    pygame.draw.circle(screen, MOON_COLOUR, MOON_POS,MOON_RADIUS)
    draw_text(screen, "MOON", (MOON_POS[0], MOON_POS[1] + MOON_RADIUS + 6))

    

    for idx, obj in enumerate(all_objects):
        obj.draw(screen, warning=idx in warning_ids)

    for rocket in rockets:
        rocket.draw(screen)

    for mission in missions:
        mission.draw(screen)

    panel_lines = [
        "Space Sentinel",
        f"Tracked objects : {len(all_objects)}",
        f"Active warnings : {len(warning_ids)}",
        f"Rockets in transit : {len(rockets)}",
        
        "",
        "[L] Launch rocket        [ESC] Quit",
    ]
    for i, line in enumerate(panel_lines):
        color = WARNING_COLOR if ("warnings" in line and warning_ids) else TEXT_COLOR
        f = font_big if i == 0 else font_small
        draw_text(screen, line, (10, 10 + i * 22), color, f)

    pygame.display.flip()
    clock.tick(FPS)

pygame.quit()
sys.exit()
